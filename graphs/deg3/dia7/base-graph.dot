digraph base_graph {
  graph [bgcolor="white", pad=0.4, fontname="Arial", fontsize=13];
  node [shape=circle, width=0.42, fixedsize=true, fontname="Arial", fontsize=13, color="#1f2328", penwidth=1.6];
  edge [color="#1f2328", penwidth=1.4, arrowsize=0.75, fontname="Times New Roman", fontsize=17];

  graph [layout=dot, rankdir=LR, nodesep=0.5, ranksep=1.3];
  graph [label="200 vertices from a 5-vertex base graph over a group of order 40\n ", labelloc=t, fontsize=19, fontname="Arial", fontcolor="#1f2328"];
  0 [label=<<b>0</b>>];
  1 [label=<<b>1</b>>];
  2 [label=<<b>2</b>>];
  3 [label=<<b>3</b>>];
  4 [label=<<b>4</b>>];
  0 -> 1 [label=<1>];
  0 -> 2 [label=<1>];
  0 -> 3 [label=<1>];
  1 -> 4 [label=<1>];
  1 -> 2 [label=<<i>y</i>>];
  semi2 [shape=point, width=0.01, style=invis];
  2 -> semi2 [label=<<i>y⁴</i>>, arrowhead=tee, arrowsize=1.3, len=1.1];
  3 -> 3 [label=<<i>xy²</i>>, dir=none];
  4 -> 4 [label=<<i>x²y²</i>>, dir=none];
}
