  rng2 [pos="690,160!", shape=plaintext, fixedsize=false, width=0, height=0, fontcolor="#8c959f", fontsize=12, label=<2N .. 3N-1>];
  run3 [pos="40,90!", shape=plaintext, fixedsize=false, width=0, height=0, fontcolor="#8c959f", fontsize=12, label=<run 3>];
  v3_0 [pos="120,90!", shape=circle, style=filled, fillcolor="#1f2328", color="#1f2328", width=0.13, label=""];
  v3_1 [pos="180,90!", shape=circle, style=filled, fillcolor="#1f2328", color="#1f2328", width=0.13, label=""];
  v3_2 [pos="240,90!", shape=circle, style=filled, fillcolor="#1f2328", color="#1f2328", width=0.13, label=""];
  v3_3 [pos="300,90!", shape=circle, style=filled, fillcolor="#1f2328", color="#1f2328", width=0.13, label=""];
  v3_4 [pos="360,90!", shape=circle, style=filled, fillcolor="#1f2328", color="#1f2328", width=0.13, label=""];
