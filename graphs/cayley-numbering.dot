  v3_6 [pos="480,90!", shape=circle, style=filled, fillcolor="#1f2328", color="#1f2328", width=0.13, label=""];
  v3_7 [pos="540,90!", shape=circle, style=filled, fillcolor="#1f2328", color="#1f2328", width=0.13, label=""];
  dots3 [pos="600,90!", shape=plaintext, fixedsize=false, width=0, height=0, fontcolor="#8c959f", fontsize=14, label=<...>];
  rng3 [pos="690,90!", shape=plaintext, fixedsize=false, width=0, height=0, fontcolor="#8c959f", fontsize=12, label=<3N .. 4N-1>];
  v0_1 -> v2_3 [color="#0969da", penwidth=2];
  v1_2 -> v3_6 [color="#0969da", penwidth=2];
}
