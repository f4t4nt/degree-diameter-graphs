digraph cayley_numbering {
  graph [bgcolor="white", pad=0.4, fontname="Arial", fontsize=13];
  node [shape=circle, width=0.42, fixedsize=true, fontname="Arial", fontsize=13, color="#1f2328", penwidth=1.6];
  edge [color="#1f2328", penwidth=1.4, arrowsize=0.75, fontname="Times New Roman", fontsize=17];

  graph [layout=neato, inputscale=72, splines=true];
  graph [label="Each generator moves every vertex from run j to run j + b\n ", labelloc=t, fontsize=19, fontname="Arial", fontcolor="#1f2328"];
  run0 [pos="40,300!", shape=plaintext, fixedsize=false, width=0, height=0, fontcolor="#8c959f", fontsize=12, label=<run 0>];
  v0_0 [pos="120,300!", shape=circle, style=filled, fillcolor="#1f2328", color="#1f2328", width=0.13, label=""];
  v0_1 [pos="180,300!", shape=circle, style=filled, fillcolor="#1f2328", color="#1f2328", width=0.13, label=""];
  v0_2 [pos="240,300!", shape=circle, style=filled, fillcolor="#1f2328", color="#1f2328", width=0.13, label=""];
  v0_3 [pos="300,300!", shape=circle, style=filled, fillcolor="#1f2328", color="#1f2328", width=0.13, label=""];
  v0_4 [pos="360,300!", shape=circle, style=filled, fillcolor="#1f2328", color="#1f2328", width=0.13, label=""];
  v0_5 [pos="420,300!", shape=circle, style=filled, fillcolor="#1f2328", color="#1f2328", width=0.13, label=""];
  v0_6 [pos="480,300!", shape=circle, style=filled, fillcolor="#1f2328", color="#1f2328", width=0.13, label=""];
  v0_7 [pos="540,300!", shape=circle, style=filled, fillcolor="#1f2328", color="#1f2328", width=0.13, label=""];
  dots0 [pos="600,300!", shape=plaintext, fixedsize=false, width=0, height=0, fontcolor="#8c959f", fontsize=14, label=<...>];
  rng0 [pos="690,300!", shape=plaintext, fixedsize=false, width=0, height=0, fontcolor="#8c959f", fontsize=12, label=<0 .. N-1>];
  run1 [pos="40,230!", shape=plaintext, fixedsize=false, width=0, height=0, fontcolor="#8c959f", fontsize=12, label=<run 1>];
  v1_0 [pos="120,230!", shape=circle, style=filled, fillcolor="#1f2328", color="#1f2328", width=0.13, label=""];
  v1_1 [pos="180,230!", shape=circle, style=filled, fillcolor="#1f2328", color="#1f2328", width=0.13, label=""];
  v1_2 [pos="240,230!", shape=circle, style=filled, fillcolor="#1f2328", color="#1f2328", width=0.13, label=""];
  v1_3 [pos="300,230!", shape=circle, style=filled, fillcolor="#1f2328", color="#1f2328", width=0.13, label=""];
  v1_4 [pos="360,230!", shape=circle, style=filled, fillcolor="#1f2328", color="#1f2328", width=0.13, label=""];
  v1_5 [pos="420,230!", shape=circle, style=filled, fillcolor="#1f2328", color="#1f2328", width=0.13, label=""];
  v1_6 [pos="480,230!", shape=circle, style=filled, fillcolor="#1f2328", color="#1f2328", width=0.13, label=""];
  v1_7 [pos="540,230!", shape=circle, style=filled, fillcolor="#1f2328", color="#1f2328", width=0.13, label=""];
  dots1 [pos="600,230!", shape=plaintext, fixedsize=false, width=0, height=0, fontcolor="#8c959f", fontsize=14, label=<...>];
  rng1 [pos="690,230!", shape=plaintext, fixedsize=false, width=0, height=0, fontcolor="#8c959f", fontsize=12, label=<1N .. 2N-1>];
  run2 [pos="40,160!", shape=plaintext, fixedsize=false, width=0, height=0, fontcolor="#8c959f", fontsize=12, label=<run 2>];
  v2_0 [pos="120,160!", shape=circle, style=filled, fillcolor="#1f2328", color="#1f2328", width=0.13, label=""];
  v2_1 [pos="180,160!", shape=circle, style=filled, fillcolor="#1f2328", color="#1f2328", width=0.13, label=""];
  v2_2 [pos="240,160!", shape=circle, style=filled, fillcolor="#1f2328", color="#1f2328", width=0.13, label=""];
  v2_3 [pos="300,160!", shape=circle, style=filled, fillcolor="#1f2328", color="#1f2328", width=0.13, label=""];
  v2_4 [pos="360,160!", shape=circle, style=filled, fillcolor="#1f2328", color="#1f2328", width=0.13, label=""];
  v2_5 [pos="420,160!", shape=circle, style=filled, fillcolor="#1f2328", color="#1f2328", width=0.13, label=""];
  v2_6 [pos="480,160!", shape=circle, style=filled, fillcolor="#1f2328", color="#1f2328", width=0.13, label=""];
  v2_7 [pos="540,160!", shape=circle, style=filled, fillcolor="#1f2328", color="#1f2328", width=0.13, label=""];
