digraph base_graph {
  graph [bgcolor="white", pad=0.4, fontname="Arial", fontsize=13];
  node [shape=circle, width=0.42, fixedsize=true, fontname="Arial", fontsize=13, color="#1f2328", penwidth=1.6];
  edge [color="#1f2328", penwidth=1.4, arrowsize=0.75, fontname="Times New Roman", fontsize=17];

  graph [layout=dot, rankdir=LR, nodesep=0.5, ranksep=2.4];
  graph [label="6,000 vertices from a 2-vertex base graph over a group of order 3,000\n ", labelloc=t, fontsize=19, fontname="Arial", fontcolor="#1f2328"];
  0 [label=<<b>0</b>>];
  1 [label=<<b>1</b>>];
  0 -> 1 [label=<1>];
  0 -> 1 [label=<<i>((0, 1), c, z) y⁴</i>>];
  0 -> 1 [label=<<i>((1, 4), c, z⁴) y⁷</i>>];
  0 -> 0 [label=<<i>y</i>>, dir=none];
  1 -> 1 [label=<<i>((0, 2), c, z⁴) y⁴</i>>, dir=none];
}
