graph flag_gadget {
  graph [bgcolor="white", pad=0.4, fontname="Arial", fontsize=13];
  node [shape=circle, width=0.42, fixedsize=true, fontname="Arial", fontsize=13, color="#1f2328", penwidth=1.6];
  edge [color="#1f2328", penwidth=1.4, arrowsize=0.75, fontname="Times New Roman", fontsize=17];

  graph [layout=neato, inputscale=72, splines=false];
  graph [label="Subdividing a flag of H(4) keeps every degree at 5\n ", labelloc=t, fontsize=19, fontname="Arial", fontcolor="#1f2328"];
  pstub0 [pos="75,170!", shape=point, width=0.01, style=invis];
  p -- pstub0 [color="#8c959f"];
  Lstub0 [pos="525,170!", shape=point, width=0.01, style=invis];
  L -- Lstub0 [color="#8c959f"];
  pstub1 [pos="50,170!", shape=point, width=0.01, style=invis];
  p -- pstub1 [color="#8c959f"];
  Lstub1 [pos="550,170!", shape=point, width=0.01, style=invis];
  L -- Lstub1 [color="#8c959f"];
  pstub2 [pos="25,170!", shape=point, width=0.01, style=invis];
  p -- pstub2 [color="#8c959f"];
  Lstub2 [pos="575,170!", shape=point, width=0.01, style=invis];
  L -- Lstub2 [color="#8c959f"];
  pstub3 [pos="0,170!", shape=point, width=0.01, style=invis];
  p -- pstub3 [color="#8c959f"];
  Lstub3 [pos="600,170!", shape=point, width=0.01, style=invis];
  L -- Lstub3 [color="#8c959f"];
  p [pos="100,100!", shape=circle, style=filled, fillcolor="#1f2328", width=0.36, label=""];
  L [pos="500,100!", shape=square, style=filled, fillcolor="#1f2328", width=0.34, label=""];
  w [pos="300,100!", shape=circle, color="#0969da", penwidth=2.4, width=0.36, label=""];
  p -- w [penwidth=2];
  w -- L [penwidth=2];
  f0 [pos="210,220!", shape=circle, color="#0969da", penwidth=2, width=0.3, label=""];
  w -- f0 [color="#0969da", penwidth=2];
  f1 [pos="300,220!", shape=circle, color="#0969da", penwidth=2, width=0.3, label=""];
  w -- f1 [color="#0969da", penwidth=2];
  f2 [pos="390,220!", shape=circle, color="#0969da", penwidth=2, width=0.3, label=""];
  w -- f2 [color="#0969da", penwidth=2];
  pl [pos="100,70!", shape=plaintext, fixedsize=false, width=0, height=0, fontcolor="#1f2328", fontsize=13, label=<point p>];
  Ll [pos="500,70!", shape=plaintext, fixedsize=false, width=0, height=0, fontcolor="#1f2328", fontsize=13, label=<line L>];
  wl [pos="300,70!", shape=plaintext, fixedsize=false, width=0, height=0, fontcolor="#1f2328", fontsize=13, label=<new vertex w>];
  fl [pos="300,250!", shape=plaintext, fixedsize=false, width=0, height=0, fontcolor="#0969da", fontsize=12, label=<edges of F>];
}
